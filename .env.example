# STARDUST Command Center Environment Configuration Template
# For local development, copy this file to .env and configure values.
# NEVER commit credentials or secrets to version control.

# =========================================================================
# Razorpay Public API Credentials
# Used by the sandbox/mock gateway integrations.
# =========================================================================
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# =========================================================================
# Security Warning
# The Razorpay Key Secret (e.g. RAZORPAY_KEY_SECRET) is private and must
# NEVER be prefixed with "VITE_" or imported in client-side React bundles.
# Secrets must be kept strictly server-side on your hosting configuration.
# =========================================================================
